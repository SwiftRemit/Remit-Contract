# Stellar network
STELLAR_NETWORK=testnet

# Deployer / admin keypair
DEPLOYER_SECRET=S...
ADMIN_PUBLIC_KEY=G...

# Sender keypair (for testing)
SENDER_SECRET=S...
SENDER_PUBLIC_KEY=G...

# Recipient (for testing)
RECIPIENT_PUBLIC_KEY=G...

# Token contract address (SAC for XLM or USDC issuer)
TOKEN_ADDRESS=C...

# Deployed contract ID (filled in after deploy.sh)
CONTRACT_ID=C...
